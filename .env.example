# Plantilla de variables de entorno. NO poner valores reales aquí.
# Para desarrollo local puedes copiar este archivo a .env (que está en .gitignore)
# o, más sencillo, usar secrets/passwords.yml.

# Dominio de producción (para canonical, Open Graph y sitemap).
# En Netlify se rellena solo con la variable URL.
URL=http://localhost:8080
# SITE_URL tiene prioridad sobre URL si se configura un dominio propio.
# SITE_URL=https://dominio-definitivo.es

# Contraseñas de los itinerarios privados (una por viaje).
# Formato: ITINERARIO_PW_<SLUG EN MAYÚSCULAS, guiones -> guion bajo>
# ITINERARIO_PW_JAPON=
# ITINERARIO_PW_LONDRES=
# ITINERARIO_PW_VIETNAM=
# ITINERARIO_PW_ESCOCIA=
# ITINERARIO_PW_SRI_LANKA_TURQUIA=
